#!/bin/sh
# Runs static analysis (Spotless + Detekt) before allowing a commit.
# Opt in: `git config core.hooksPath .githooks` (one-time per clone).

set -e

autocrlf=$(git config --bool core.autocrlf 2>/dev/null || echo "false")
if [ "$autocrlf" = "true" ]; then
    echo ""
    echo "ERROR: core.autocrlf=true causes CRLF line-ending violations in Spotless."
    echo "Fix with: git config core.autocrlf input"
    echo ""
    exit 1
fi

gradle=${PRECOMMIT_GRADLE:-./gradlew}

echo "Running static analysis..."
status=0
$gradle spotlessCheck detekt --quiet || status=$?
case $status in
    0) ;;
    75)
        echo ""
        echo "ERROR: The build queue did not start the static analysis (exit $status). Nothing was checked."
        echo "Retry the commit."
        echo ""
        exit "$status"
        ;;
    76)
        echo ""
        echo "ERROR: The build queue reported an error (exit $status). Nothing was checked."
        echo "The [build-queue] line above names the cause."
        echo ""
        exit "$status"
        ;;
    *)
        echo ""
        echo "ERROR: Static analysis failed."
        echo "Fix formatting with: $gradle spotlessApply"
        echo "Check Detekt report:  $gradle detekt"
        echo ""
        exit 1
        ;;
esac
